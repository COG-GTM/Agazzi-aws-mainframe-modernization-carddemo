<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <!--
    5B performance: synthetic data generator. Standalone build (not a module of modern/pom.xml, which
    5B must not touch): it inherits the parent conventions (Java 21, Checkstyle, Spotless, JaCoCo)
    and depends on the Fase 0 codecs of carddemo-copybook. Build from modern/:
      ./mvnw -B -q install -pl carddemo-copybook -am -DskipTests
      ./mvnw -B -f perf/datagen/pom.xml verify
  -->
  <parent>
    <groupId>com.carddemo</groupId>
    <artifactId>carddemo-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>carddemo-perf-datagen</artifactId>
  <name>carddemo-perf-datagen</name>
  <description>Deterministic synthetic CardDemo data (x1000 of app/data/ASCII) for 5B load tests</description>

  <properties>
    <modern.root>${project.basedir}/../..</modern.root>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.carddemo</groupId>
      <artifactId>carddemo-copybook</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.carddemo.perf.datagen.DataGenMain</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-runtime-deps</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
