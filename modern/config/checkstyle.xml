<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- CardDemo rules: formatting is enforced by Spotless (google-java-format); Checkstyle guards
     correctness/consistency rules, including the numeric contract of plan §3.4 (no double/float). -->
<module name="Checker">
  <property name="severity" value="warning"/>
  <module name="FileTabCharacter"/>
  <module name="NewlineAtEndOfFile"/>
  <module name="TreeWalker">
    <module name="AvoidStarImport"/>
    <module name="UnusedImports"/>
    <module name="RedundantImport"/>
    <module name="IllegalImport"/>
    <module name="PackageName">
      <property name="format" value="^com\.carddemo(\.[a-z][a-z0-9]*)*$"/>
    </module>
    <module name="TypeName"/>
    <module name="EqualsHashCode"/>
    <module name="EmptyStatement"/>
    <module name="MissingSwitchDefault"/>
    <module name="OneStatementPerLine"/>
    <module name="IllegalType">
      <property name="illegalClassNames" value="java.lang.Double, java.lang.Float"/>
      <property name="tokens" value="VARIABLE_DEF, PARAMETER_DEF, METHOD_DEF"/>
    </module>
    <module name="Regexp">
      <property name="format" value="\b(double|float)\s+\w+\s*[=;,)]"/>
      <property name="illegalPattern" value="true"/>
      <property name="message" value="Plan §3.4: monetary/numeric COBOL values use BigDecimal, never double/float"/>
    </module>
  </module>
</module>
