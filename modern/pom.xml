<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Fase 0 owns this file. Workstreams MUST NOT modify it (plan §3.2/§4): add dependencies
       (without <version>) in your own module pom.xml; propose changes as CONTRACT-CHANGE. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.carddemo</groupId>
  <artifactId>carddemo-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>CardDemo modernization (Java 21)</name>

  <modules>
    <module>carddemo-contracts</module>
    <module>carddemo-domain</module>
    <module>carddemo-copybook</module>
    <module>carddemo-datamigration</module>
    <module>carddemo-platform</module>
    <module>carddemo-batch-posting</module>
    <module>carddemo-batch-interest</module>
    <module>carddemo-batch-reports</module>
    <module>carddemo-batch-datalifecycle</module>
    <module>carddemo-batch-orchestration</module>
    <module>carddemo-online-common</module>
    <module>carddemo-online-auth</module>
    <module>carddemo-online-account</module>
    <module>carddemo-online-card</module>
    <module>carddemo-online-transaction</module>
    <module>carddemo-online-useradmin</module>
    <module>carddemo-ext-authorization</module>
    <module>carddemo-ext-trantype</module>
    <module>carddemo-ext-mqinquiry</module>
    <module>carddemo-app</module>
    <module>carddemo-parity</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <archunit.version>1.3.0</archunit.version>
    <testcontainers.version>1.21.4</testcontainers.version>
    <spring-cloud-aws.version>3.2.1</spring-cloud-aws.version>
    <awssdk.version>2.28.29</awssdk.version>
    <openpdf.version>2.0.3</openpdf.version>
    <jrecord.version>0.93.3</jrecord.version>
    <checkstyle-plugin.version>3.5.0</checkstyle-plugin.version>
    <checkstyle.version>10.18.2</checkstyle.version>
    <spotless.version>2.43.0</spotless.version>
    <google-java-format.version>1.22.0</google-java-format.version>
    <jacoco.version>0.8.12</jacoco.version>
    <!-- Test tags: `parity` runs with -Pparity, `it` with -Pit, `pending-o1` (online goldens
         waiting for O1) is always excluded until O1 merges. -->
    <surefire.excludedGroups>parity,it,pending-o1</surefire.excludedGroups>
    <skipITs>true</skipITs>
    <modern.root>${maven.multiModuleProjectDirectory}</modern.root>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-contracts</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-copybook</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-platform</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-online-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-datamigration</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-batch-posting</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-batch-interest</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-batch-reports</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-batch-datalifecycle</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-batch-orchestration</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-online-auth</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-online-account</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-online-card</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-online-transaction</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-online-useradmin</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-ext-authorization</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-ext-trantype</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-ext-mqinquiry</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-app</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- Spring Boot BOM (from the parent) already manages: Spring Batch 5, Data JPA, Security 6,
           Web, Actuator, Flyway, PostgreSQL driver, Jackson, RestAssured, SnakeYAML, JUnit 5. -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${awssdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.awspring.cloud</groupId>
        <artifactId>spring-cloud-aws-dependencies</artifactId>
        <version>${spring-cloud-aws.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.librepdf</groupId>
        <artifactId>openpdf</artifactId>
        <version>${openpdf.version}</version>
      </dependency>
      <!-- JRecord (ADR-004). Coordinates as published by the JRecord project; not used by any
           Fase 0 module, 1A verifies resolution before adopting it (see ADR-004). -->
      <dependency>
        <groupId>net.sf.jrecord</groupId>
        <artifactId>JRecord</artifactId>
        <version>${jrecord.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <excludedGroups>${surefire.excludedGroups}</excludedGroups>
            <trimStackTrace>false</trimStackTrace>
            <systemPropertyVariables>
              <modern.root>${modern.root}</modern.root>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <configuration>
            <skipITs>${skipITs}</skipITs>
            <systemPropertyVariables>
              <modern.root>${modern.root}</modern.root>
            </systemPropertyVariables>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>${checkstyle-plugin.version}</version>
          <dependencies>
            <dependency>
              <groupId>com.puppycrawl.tools</groupId>
              <artifactId>checkstyle</artifactId>
              <version>${checkstyle.version}</version>
            </dependency>
          </dependencies>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <banDuplicatePomDependencyVersions/>
                <bannedDependencies>
                  <excludes>
                    <exclude>log4j:log4j</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <configuration>
          <configLocation>${modern.root}/config/checkstyle.xml</configLocation>
          <consoleOutput>true</consoleOutput>
          <failOnViolation>true</failOnViolation>
          <violationSeverity>warning</violationSeverity>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
        </configuration>
        <executions>
          <execution>
            <id>checkstyle</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
            </googleJavaFormat>
            <removeUnusedImports/>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- Unit + golden parity tests (batch goldens, comparators, online YAML runner). -->
      <id>parity</id>
      <properties>
        <surefire.excludedGroups>it,pending-o1</surefire.excludedGroups>
      </properties>
    </profile>
    <profile>
      <!-- Integration tests (*IT, Testcontainers PostgreSQL 16 / LocalStack SQS). -->
      <id>it</id>
      <properties>
        <skipITs>false</skipITs>
      </properties>
    </profile>
  </profiles>
</project>
