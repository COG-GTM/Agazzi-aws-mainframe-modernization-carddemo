{
  "name": "carddemo-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "CardDemo SPA (O6): React + TypeScript replacement of the 3270 BMS screens, client generated from openapi.yaml",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen": "npm run gen:api && npm run gen:bms",
    "gen:api": "openapi-typescript ../carddemo-contracts/src/main/resources/openapi/openapi.yaml -o src/generated/api.d.ts",
    "gen:bms": "node scripts/gen-bms-layouts.mjs",
    "gen:check": "npm run gen && git diff --exit-code -- src/generated",
    "dev": "vite",
    "mock": "prism mock -p 4010 ../carddemo-contracts/src/main/resources/openapi/openapi.yaml",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && vitest run",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "openapi-fetch": "^0.12.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.12.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "yaml": "^2.6.1"
  }
}
